{
  "name": "@dpdpa/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "prisma generate && tsc -p tsconfig.build.json --watch",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "lint": "eslint . --config ../../eslint.config.js && prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dpdpa/contracts": "workspace:*",
    "@dpdpa/observability": "workspace:*",
    "@kubernetes/client-node": "^2.0.2",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.4.1",
    "@nestjs/platform-fastify": "12.4.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-prometheus": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.43.0",
    "bullmq": "6.7.5",
    "dockerode": "^5.0.1",
    "fastify": "5.12.8",
    "ioredis": "^6.0.0",
    "pdfkit": "^0.20.2",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "puppeteer-core": "25.17.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.1",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "testcontainers": "12.2.1",
    "typescript": "~6.0",
    "vitest": "^5.1.0"
  }
}

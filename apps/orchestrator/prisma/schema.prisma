generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (docs/database.md §3) ────────────────────────────────────────

enum OrgPlan {
  free
  starter
  growth
  enterprise

  @@map("org_plan")
}

enum MemberRole {
  owner
  admin
  auditor
  viewer

  @@map("member_role")
}

enum MembershipStatus {
  invited
  active
  suspended

  @@map("membership_status")
}

enum RepoVisibility {
  public
  private
  internal

  @@map("repo_visibility")
}

enum ScanStatus {
  queued
  cloning
  scanning
  mapping
  completed
  failed
  cancelled
  expired

  @@map("scan_status")
}

enum ScanTrigger {
  manual
  api

  @@map("scan_trigger")
}

enum ScannerName {
  semgrep
  checkov
  gitleaks

  @@map("scanner_name")
}

enum ScannerStatus {
  pending
  running
  completed
  failed
  timed_out
  skipped

  @@map("scanner_status")
}

enum FindingSeverity {
  critical
  high
  medium
  low
  info

  @@map("finding_severity")
}

enum FindingStatus {
  open
  false_positive
  accepted_risk
  fixed
  reopened

  @@map("finding_status")
}

enum MappingConfidence {
  direct
  inferred
  advisory

  @@map("mapping_confidence")
}

enum ReportStatus {
  queued
  rendering
  ready
  failed
  expired

  @@map("report_status")
}

enum ReportFormat {
  pdf

  @@map("report_format")
}

// ── Tables (docs/database.md §4) ───────────────────────────────────────

model Organization {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @db.Text
  slug              String    @unique @db.Citext
  plan              OrgPlan   @default(free)
  dataRegion        String    @default("ap-south-1") @map("data_region") @db.Text
  retentionDays     Int       @default(90) @map("retention_days")
  scanConcurrency   Int       @default(3) @map("scan_concurrency") @db.SmallInt
  billingCustomerId String?   @unique @map("billing_customer_id") @db.Text
  settings          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  memberships     Membership[]
  repositories    Repository[]
  apiKeys         ApiKey[]
  scans           Scan[]
  scanEvents      ScanEvent[]
  findings        ScannerFinding[]
  remediationLogs RemediationLog[]
  reports         Report[]
  auditLogs       AuditLog[]
  usageEvents     UsageEvent[]
  sessions        Session[]
  invites         MembershipInvite[]

  @@map("organizations")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.Citext
  name            String?   @db.Text
  avatarUrl       String?   @map("avatar_url") @db.Text
  githubUserId    BigInt?   @unique @map("github_user_id")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  memberships           Membership[]
  membershipsInvited    Membership[]     @relation("MembershipInvitedBy")
  repositoriesConnected Repository[]     @relation("RepoConnectedBy")
  apiKeysCreated        ApiKey[]         @relation("ApiKeyCreatedBy")
  scansRequested        Scan[]           @relation("ScanRequestedBy")
  remediationActor      RemediationLog[] @relation("RemediationActor")
  reportsRequested      Report[]         @relation("ReportRequestedBy")
  auditActs             AuditLog[]       @relation("AuditActor")
  sessions              Session[]
  invitesSent           MembershipInvite[] @relation("MembershipInviteInvitedBy")

  @@map("users")
}

model Membership {
  orgId     String           @map("org_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MemberRole       @default(viewer)
  status    MembershipStatus @default(invited)
  invitedBy String?          @map("invited_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("MembershipInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@id([orgId, userId])
  @@map("memberships")
}

model MembershipInvite {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  email      String    @db.Citext
  role       MemberRole @default(viewer)
  tokenHash  String    @unique @map("token_hash") @db.Text
  invitedBy  String?   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("MembershipInviteInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([orgId, email])
  @@map("membership_invites")
}

model Repository {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String         @map("org_id") @db.Uuid
  owner         String         @db.Citext
  name          String         @db.Citext
  githubRepoId  BigInt?        @map("github_repo_id")
  fullName      String         @map("full_name") @db.Citext
  defaultBranch String         @default("main") @map("default_branch") @db.Text
  visibility    RepoVisibility @default(public)
  language      String?        @db.Text
  sizeKb        Int?           @map("size_kb")
  isArchived    Boolean        @default(false) @map("is_archived")
  connectedBy   String?        @map("connected_by") @db.Uuid
  lastScannedAt DateTime?      @map("last_scanned_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connector    User?        @relation("RepoConnectedBy", fields: [connectedBy], references: [id], onDelete: SetNull)
  scans        Scan[]

  @@unique([orgId, githubRepoId])
  @@unique([orgId, fullName])
  @@map("repositories")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  name       String    @db.Text
  keyPrefix  String    @unique @map("key_prefix") @db.Text
  keyHash    String    @unique @map("key_hash") @db.Text
  scopes     String[]
  createdBy  String?   @map("created_by") @db.Uuid
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User?        @relation("ApiKeyCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  scans        Scan[]

  @@map("api_keys")
}

model Scan {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String      @map("org_id") @db.Uuid
  repositoryId    String      @map("repository_id") @db.Uuid
  requestedBy     String?     @map("requested_by") @db.Uuid
  apiKeyId        String?     @map("api_key_id") @db.Uuid
  trigger         ScanTrigger @default(manual)
  status          ScanStatus  @default(queued)
  ref             String      @default("main") @db.Text
  commitSha       String?     @map("commit_sha") @db.Text
  scannerVersions Json        @default("{}") @map("scanner_versions")
  rulePackVersion String?     @map("rule_pack_version") @db.Text
  scoringVersion  String?     @map("scoring_version") @db.Text
  score           Decimal?    @db.Decimal(5, 2)
  grade           String?     @db.Char(1)
  sectionScores   Json        @default("{}") @map("section_scores")
  counts          Json        @default("{}")
  coverage        Json        @default("{}")
  errorCode       String?     @map("error_code") @db.Text
  errorMessage    String?     @map("error_message") @db.Text
  idempotencyKey  String?     @map("idempotency_key") @db.Text
  jobName         String?     @map("job_name") @db.Text
  secretName      String?     @map("secret_name") @db.Text
  queuedAt        DateTime    @default(now()) @map("queued_at") @db.Timestamptz
  startedAt       DateTime?   @map("started_at") @db.Timestamptz
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz
  durationMs      Int?        @map("duration_ms")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repository   Repository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  requester    User?            @relation("ScanRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  apiKey       ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  events       ScanEvent[]
  findings     ScannerFinding[]
  reports      Report[]
  usageEvents  UsageEvent[]

  @@unique([orgId, idempotencyKey])
  @@map("scans")
}

model ScanEvent {
  id        BigInt   @id @default(autoincrement())
  scanId    String   @map("scan_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  type      String   @db.Text
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  scan         Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("scan_events")
}

model DpdpaRule {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String          @unique @db.Text
  section             String          @db.Text
  title               String          @db.Text
  summary             String          @db.Text
  obligation          String          @db.Text
  legalReference      String          @map("legal_reference") @db.Text
  severity            FindingSeverity
  weight              Decimal         @default(1) @db.Decimal(4, 2)
  appliesWhen         Json            @default("{}") @map("applies_when")
  remediationGuidance String          @map("remediation_guidance") @db.Text
  version             String          @default("1.0.0") @db.Text
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @default(now()) @map("updated_at") @db.Timestamptz

  mappings RuleMapping[]
  findings ScannerFinding[]

  @@map("dpdpa_rules")
}

model RuleMapping {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dpdpaRuleId         String            @map("dpdpa_rule_id") @db.Uuid
  scanner             ScannerName
  scannerRuleId       String            @map("scanner_rule_id") @db.Text
  scannerRuleVersion  String            @default("*") @map("scanner_rule_version") @db.Text
  confidence          MappingConfidence @default(direct)
  rationale           String            @db.Text
  remediationTemplate String?           @map("remediation_template") @db.Text
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @default(now()) @map("updated_at") @db.Timestamptz

  rule DpdpaRule @relation(fields: [dpdpaRuleId], references: [id], onDelete: Cascade)

  @@unique([scanner, scannerRuleId, scannerRuleVersion, dpdpaRuleId])
  @@map("rule_mappings")
}

model ScannerFinding {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scanId             String            @map("scan_id") @db.Uuid
  orgId              String            @map("org_id") @db.Uuid
  scanner            ScannerName
  scannerRuleId      String            @map("scanner_rule_id") @db.Text
  scannerRuleVersion String?           @map("scanner_rule_version") @db.Text
  dpdpaRuleId        String?           @map("dpdpa_rule_id") @db.Uuid
  severity           FindingSeverity
  confidence         MappingConfidence @default(direct)
  filePath           String?           @map("file_path") @db.Text
  lineStart          Int?              @map("line_start")
  lineEnd            Int?              @map("line_end")
  columnStart        Int?              @map("column_start")
  columnEnd          Int?              @map("column_end")
  message            String            @db.Text
  evidenceRedacted   String?           @map("evidence_redacted") @db.Text
  evidenceHash       String?           @map("evidence_hash") @db.Text
  fingerprint        String            @db.Text
  status             FindingStatus     @default(open)
  isNew              Boolean           @default(true) @map("is_new")
  firstSeenAt        DateTime          @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt         DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz
  context            Json              @default("{}")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @default(now()) @map("updated_at") @db.Timestamptz

  scan            Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  dpdpaRule       DpdpaRule?       @relation(fields: [dpdpaRuleId], references: [id], onDelete: SetNull)
  remediationLogs RemediationLog[]

  @@unique([scanId, fingerprint])
  @@map("scanner_findings")
}

model RemediationLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  findingId   String   @map("finding_id") @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.Text
  note        String?  @db.Text
  externalUrl String?  @map("external_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  finding      ScannerFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?          @relation("RemediationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("remediation_logs")
}

model Report {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scanId          String       @map("scan_id") @db.Uuid
  orgId           String       @map("org_id") @db.Uuid
  status          ReportStatus @default(queued)
  format          ReportFormat @default(pdf)
  templateVersion String       @map("template_version") @db.Text
  storageKey      String?      @unique @map("storage_key") @db.Text
  sha256          String?      @db.Char(64)
  sizeBytes       BigInt?      @map("size_bytes")
  requestedBy     String?      @map("requested_by") @db.Uuid
  errorMessage    String?      @map("error_message") @db.Text
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamptz

  scan         Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requester    User?        @relation("ReportRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)

  @@map("reports")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  orgId        String?  @map("org_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorType    String   @map("actor_type") @db.Text
  action       String   @db.Text
  resourceType String   @map("resource_type") @db.Text
  resourceId   String?  @map("resource_id") @db.Uuid
  ip           String?  @db.Inet
  userAgent    String?  @map("user_agent") @db.Text
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model UsageEvent {
  id        BigInt   @id @default(autoincrement())
  orgId     String?  @map("org_id") @db.Uuid
  scanId    String?  @map("scan_id") @db.Uuid
  eventType String   @map("event_type") @db.Text
  eventId   String   @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  quantity  Decimal  @default(1) @db.Decimal(12, 4)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  scan         Scan?         @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@unique([orgId, eventId])
  @@map("usage_events")
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  activeOrgId       String?   @map("active_org_id") @db.Uuid
  ip                String?   @db.Inet
  userAgent         String?   @map("user_agent") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrg Organization? @relation(fields: [activeOrgId], references: [id], onDelete: SetNull)

  @@map("sessions")
}

apps/web/playwright.local.config.ts

# CodeScene MCP recreates a credentials dir literally named `?` in cwd
\?/
**/.codescene/

# Husky internals
.husky/_/


# Local database files
prisma/*.db
prisma/*.db-journal

# Playwright MCP session artifacts (never committed)
.playwright-mcp/

# Python caches
__pycache__/
*.py[cod]

# Local tool caches
.tmp/
.agents/
# Added by code-review-graph
.code-review-graph/

# Database and queue (orchestrator)
DATABASE_URL=postgresql://user:password@localhost:5432/dpdpa_dev
REDIS_URL=redis://localhost:6379

# Orchestrator internal auth (orchestrator + web)
ORCHESTRATOR_HMAC_KEY=<32+ character hex secret>
ORCHESTRATOR_INTERNAL_KEY=<32+ character hex secret>

# Orchestrator connection (web only)
ORCHESTRATOR_URL=http://localhost:3001

# Nuxt app secret (web only; ≥32 chars for session seal + HKDF)
# Generate with: openssl rand -base64 32
NUXT_APP_SECRET=<32+ character secret>

# GitHub OAuth (web only)
# Register at https://github.com/settings/applications/new
# Callback URL: http://localhost:3000/api/auth/github/callback (dev) or https://<your-domain>/api/auth/github/callback (prod)
NUXT_OAUTH_GITHUB_CLIENT_ID=<GitHub OAuth App client ID>
NUXT_OAUTH_GITHUB_CLIENT_SECRET=<GitHub OAuth App client secret>

# Public app URL (web only; empty in local dev)
NUXT_PUBLIC_APP_URL=

# Optional: telemetry (web only; empty = disabled)
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_POSTHOG_KEY=

# Optional: feature flags (orchestrator only; JSON map)
# Example: FEATURE_FLAGS='{"auditExport":true}'
FEATURE_FLAGS=

# Optional: rule pack (orchestrator only; post-MVP)
RULE_PACK_DIR=
RULE_PACK_PUBLIC_KEY=

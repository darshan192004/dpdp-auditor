# Database and queue (orchestrator)
DATABASE_URL=postgresql://user:password@localhost:5432/dpdpa_dev
REDIS_URL=redis://localhost:6379

# Orchestrator internal auth (orchestrator + web)
ORCHESTRATOR_HMAC_KEY=<32+ character hex secret>
ORCHESTRATOR_INTERNAL_KEY=<32+ character hex secret>

# Orchestrator connection (web only)
ORCHESTRATOR_URL=http://localhost:3001

# Runner (orchestrator only)
RUNNER_DRIVER=docker
RUNNER_IMAGE=dpdpa/scan-runner:local
# Use a host-reachable URL for Docker; K8s can use http://orchestrator:3001
ORCHESTRATOR_CALLBACK_URL=http://host.docker.internal:3001
# Linux/macOS: /var/run/docker.sock
# Windows: //./pipe/docker_engine
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Nuxt app secret (web only; ≥32 chars for session seal + HKDF)
# Generate with: openssl rand -base64 32
NUXT_APP_SECRET=<32+ character secret>

# GitHub OAuth (web only)
# Register at https://github.com/settings/applications/new
# Callback URL: http://localhost:3000/api/auth/github/callback (dev) or https://<your-domain>/api/auth/github/callback (prod)
NUXT_OAUTH_GITHUB_CLIENT_ID=<GitHub OAuth App client ID>
NUXT_OAUTH_GITHUB_CLIENT_SECRET=<GitHub OAuth App client secret>

# Public app URL (web only; empty in local dev)
NUXT_PUBLIC_APP_URL=

# Optional: telemetry (web only; empty = disabled)
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_POSTHOG_KEY=

# Optional: feature flags (orchestrator only; JSON map)
# Example: FEATURE_FLAGS='{"auditExport":true}'
FEATURE_FLAGS=

# Optional: rule pack (orchestrator only; post-MVP)
RULE_PACK_DIR=
RULE_PACK_PUBLIC_KEY=

# Local development only (orchestrator): relax product limits for E2E checks.
# Boot fails with NODE_ENV=production if REPO_SIZE_CAP_MB=0 or
# UNLIMITED_PLAN_QUOTA=true. Production keeps the per-plan caps in docs/PRD.md §10.
# REPO_SIZE_CAP_MB=0
# UNLIMITED_PLAN_QUOTA=true

# Optional: forward longer per-scanner timeouts to the runner (seconds).
# Only the variables set here are passed into the scan Secret. In Kubernetes,
# activeDeadlineSeconds=900 still caps the total Job duration.
# TIMEOUT_CLONE=900
# TIMEOUT_SEMGREP=600
# TIMEOUT_CHECKOV=600
# TIMEOUT_GITLEAKS=300

# Private remote Chromium DevTools WebSocket endpoint used by report.render.
# The orchestrator image intentionally does not embed or launch a browser.
# REPORTS_BROWSER_WS_ENDPOINT=wss://authenticated-browser.internal/devtools/browser/<id>
